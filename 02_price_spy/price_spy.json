      "parameters": {
        "jsCode": "// Данные от API конкурента\nconst apiData = $json;\n\n// Данные из нашей таблицы Google Sheets (указываем точное имя узла)\nconst sheetData = $('Get row(s) in sheet').item.json; \n\n// Проверка, что API не выдало ошибку\nif (!apiData.items || apiData.items.length === 0) {\n  return [{ json: { skip: true } }]; \n}\n\n// Берем самую низкую цену и название магазина\nconst minPrice = apiData.items[0].lowest_ask_decimal;\nconst bestProvider = apiData.items[0].provider;\n\n// Берем нашу цену из таблицы (превращаем текст в число)\nconst ggselPrice = parseFloat(sheetData.ggsel_price);\n\n// Считаем разницу в процентах\nconst diffPercent = (((ggselPrice - minPrice) / ggselPrice) * 100).toFixed(1);\n\nreturn [{\n  json: {\n    item_name: sheetData.item_name,\n    ggsel_price: ggselPrice,\n    min_competitor_price: minPrice,\n    competitor_name: bestProvider,\n    diff_percent: diffPercent,\n    is_critical: parseFloat(diffPercent) > 5 // Падение больше 5%\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        96
