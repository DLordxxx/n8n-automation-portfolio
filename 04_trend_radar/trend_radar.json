    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst messages = staticData.final_messages || [];\n\n// Если ничего не собрали\nif (messages.length === 0) {\n  staticData.final_messages = [];\n  staticData.sent_appids = [];\n  return [{ json: { text: \"🤖 <b>Анализ завершен.</b>\\nСегодня не найдено игр с высоким или средним RMT-потенциалом.\" } }];\n}\n\n// Склеиваем все карточки игр в один большой текст\nconst fullText = messages.join('\\n---\\n');\n\n// Лимит Телеграма — 4096 символов. Берем 3500 для запаса.\nconst MAX_LENGTH = 3500;\nlet chunks = [];\nlet currentChunk = \"\";\n\n// Бьем текст на куски\nconst blocks = fullText.split('\\n---\\n'); \nfor (let block of blocks) {\n  if ((currentChunk + block).length > MAX_LENGTH) {\n    chunks.push(currentChunk);\n    currentChunk = block + '\\n---\\n';\n  } else {\n    currentChunk += block + '\\n---\\n';\n  }\n}\nif (currentChunk.trim() !== \"\") {\n  chunks.push(currentChunk);\n}\n\n// Очищаем память для следующего запуска\nstaticData.final_messages = [];\nstaticData.sent_appids = [];\n\n// Возвращаем массив (n8n сам поймет, что нужно отправить несколько сообщений)\nreturn chunks.map(chunk => ({ json: { text: chunk } }));"
      },
