    {
      "parameters": {
        "jsCode": "const currentGame = $('Parse Steam Data').item.json;\nconst today = new Date().toISOString().split('T')[0];\nconst existingRows = $input.all();\n\nlet isDuplicate = false;\nlet yesterdayPeak = null;\n\nfor (const row of existingRows) {\n  if (String(row.json.appid) === String(currentGame.appid)) {\n    if (row.json.date === today) {\n      isDuplicate = true;\n    } else {\n      yesterdayPeak = row.json.peak_in_game;\n    }\n  }\n}\n\n// Считаем рост (ЭТОГО КУСКА У ТЕБЯ НЕ ХВАТАЛО)\nlet growth = 0;\nif (yesterdayPeak && currentGame.peak_in_game) {\n  growth = ((currentGame.peak_in_game - yesterdayPeak) / yesterdayPeak) * 100;\n}\n\n// Проверяем на тренд\nlet isTrend = false;\nif (!yesterdayPeak || growth > 10) { \n    isTrend = true; \n}\n\nreturn {\n  ...currentGame,\n  yesterday_peak: yesterdayPeak,\n  growth: growth.toFixed(2), // Например: \"15.40\"\n  is_duplicate: isDuplicate,\n  is_trend: isTrend\n};"
      },
