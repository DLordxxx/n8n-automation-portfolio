        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.final_messages = staticData.final_messages || [];\nstaticData.sent_appids = staticData.sent_appids || [];\n\nconst aiOutput = $('AI Agent').item.json.output || \"Вердикт отсутствует\";\nconst gameData = $('Parse Steam Data').item.json;\n\n// Формируем ссылку на Steam\nconst steamUrl = `https://store.steampowered.com/app/${gameData.appid}`;\n\n// Формируем карточку с кликабельной ссылкой\nstaticData.final_messages.push(\n  `🎮 <a href=\"${steamUrl}\"><b>${gameData.name}</b></a>\\n` +\n  `💰 <b>Цена:</b> ${gameData.price}\\n` +\n  `📊 <b>Жанры:</b> ${gameData.genres}\\n\\n` +\n  `🤖 <b>Вердикт ИИ:</b> <i>${aiOutput}</i>\\n`\n);\n\nstaticData.sent_appids.push({ appid: gameData.appid }); \n\nreturn $input.all();"
      },
