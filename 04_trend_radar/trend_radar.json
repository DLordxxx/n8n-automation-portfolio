      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst appid = Object.keys(response)[0];\nconst game = response[appid].data;\n\nif (!game) return [];\n\n// Берем онлайн из текущего шага цикла\nconst peak = $('Loop Over Items').item.json.peak_in_game;\n\nreturn [{\n  json: {\n    name: game.name,\n    price: game.is_free ? \"Бесплатно\" : (game.price_overview ? game.price_overview.final_formatted : \"Нет в продаже\"),\n    genres: game.genres ? game.genres.map(g => g.description).join(', ') : 'Не указаны',\n    appid: appid,\n    peak_in_game: peak // <--- ПРИКЛЕИВАЕМ ОНЛАЙН!\n  }\n}];"
      },
